# Gradle / IDE / build outputs
build/
.gradle/
.idea/
.kotlin/
captures/
*.iml
local.properties
.cxx/

# Android build intermediates
android/build/
android/app/build/
android/.cxx/
android/.gradle/

# Native binaries (.so files) — too large for git history (~500MB total).
# These ARE shipped in the npm tarball (see package.json `files` field +
# .npmignore keeping `android/` in the published package) but live in
# the release artifacts rather than the source repo. To re-distribute on
# npm install, you'll add a postinstall hook later (Phase 49+); for now,
# the binaries exist locally and the tarball will pick them up.
android/src/main/jniLibs/

# TypeScript build outputs
src/lib/
src/es/
*.tsbuildinfo

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# Node (when this directory hosts npm-side TS sources)
node_modules/
npm-debug.log*
yarn-error.log
.pnp/
.pnp.js

# Logs
*.log

# Test output
coverage/
junit.xml

# Local-only secrets + auth (DO NOT commit)
# .env holds NPM_TOKEN and similar env-borne secrets
# .npmrc holds the npm CLI auth token (authToken = npm_xxxx) for
# local publishing only. Token is also stored locally for `npm publish`
# to find without an OTP prompt. Repo-level .npmrc (if added later for
# registry config only) should be a separate file, e.g. .npmrc.registry,
# and should NOT be gitignored.
.env
.env.*
.npmrc
.npmrc.*

# Local secrets folder (recovery codes, etc.) — lives outside this repo
# at ../secrets/, but ignore here too in case of accidental copy.
../secrets/
secrets/