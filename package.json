{
  "name": "@simba-dev/react-native-media-player",
  "version": "1.5.16",
  "description": "React Native video/audio player powered by libmpv — Picture-in-Picture, MediaSession, custom RN UI. **V16.0.8 patch release** (2026-09-14) — D-033 16 KB page-size alignment: add_link_options(\"-Wl,-z,max-page-size=16384 -Wl,-z,common-page-size=16384\") in CMakeLists.txt + ndkVersion r27+ so libsimbaplayer_mpv.so's LOAD segments are aligned to 16 KB (Android 14+ 16 KB page-size requirement). Without this, libsimbaplayer_mpv.so shows \"LOAD segment not aligned\" in the Android App Compatibility dialog and Android refuses to load it — which cascades to \"Unknown error\" for libmpv.so, libc++_shared.so, libav*.so (all transitively loaded via libsimbaplayer_mpv.so's NEEDED list), and the app boots to a white screen. v1.5.7 pre-load attempt was insufficient because the libs themselves weren't loading at all. See CHANGELOG.md for details.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src/",
    "!src/README.example.tsx",
    "scripts/",
    "android/",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src/main/AndroidManifest.xml",
    "!android/.cxx/",
    "!android/.gradle/",
    "!android/build/",
    "assets/",
    "LICENSE",
    "README.md",
    "react-native.config.js",
    "tsconfig.json",
    "!.npmignore"
  ],
  "keywords": [
    "react-native",
    "react-native-media-player",
    "video",
    "audio",
    "mpv",
    "player",
    "pip",
    "picture-in-picture",
    "media-session",
    "foreground-service",
    "android",
    "simba"
  ],
  "license": "MIT",
  "author": {
    "name": "SIMBA Mobile Team (@simba-dev)",
    "url": "https://github.com/pavalep"
  },
  "homepage": "https://github.com/pavalep/react-native-media-player#readme",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "lint": "echo \"lint not configured yet\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "postinstall": "node ./scripts/download-native.js",
    "prepack": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.6.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-test-renderer": "19.2.3",
    "typescript": "5.5.4"
  },
  "codegenConfig": {
    "name": "SimbaPlayerSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pavalep/react-native-media-player"
  },
  "bugs": {
    "url": "https://github.com/pavalep/react-native-media-player/issues"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  }
}
