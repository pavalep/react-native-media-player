<resources>
    <!-- Base application theme. Mirrors the consumer's AppTheme definition
         so the example app launches with a similar look. The library's
         PlayerActivity references @style/AppTheme too (via its own
         AndroidManifest merger), so this must exist. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:textColor">#000000</item>
    </style>
</resources>
